# =============================================================================
# my-boda — Environment Variables
# Copy to .env:  cp .env.example .env
# All NEXT_PUBLIC_ vars are exposed to the browser at build time.
# Non-public vars (DATABASE_URL, ADMIN_PASSWORD) are server-only.
# =============================================================================

# ---------------------------------------------------------------------------
# Public — Site Identity (brand-agnostic core)
# ---------------------------------------------------------------------------
# Couple display name shown in hero, header, footer, and metadata.
NEXT_PUBLIC_COUPLE_NAME="Alex & Sam"
# Wedding date in ISO format YYYY-MM-DD — drives countdown and display.
NEXT_PUBLIC_WEDDING_DATE="2027-06-12"
# Venue display name.
NEXT_PUBLIC_VENUE="Villa del Sol, Barcelona"
# Theme id: classic | modern | garden
NEXT_PUBLIC_THEME="classic"
# Accent color (hex) used for CTAs and highlights.
NEXT_PUBLIC_ACCENT="#b48a78"

# ---------------------------------------------------------------------------
# Public — Optional Content (JSON overrides, leave empty for defaults)
# ---------------------------------------------------------------------------
# Schedule timeline — JSON array of { time, title, description? }
# Example: '[{"time":"18:00","title":"Ceremony","description":"Garden lawn"},{"time":"20:00","title":"Dinner"}]'
NEXT_PUBLIC_SCHEDULE_JSON=""

# Accommodations — JSON array of { name, url?, note? }
# Example: '[{"name":"Hotel Central","url":"https://example.com","note":"10% off with code BODA"}]'
NEXT_PUBLIC_ACCOMMODATIONS_JSON=""

# Registry / gift info — JSON object { iban?, bizum?, links: [{label,url}], message? }
# Example: '{"iban":"ES12 3456 7890 1234 5678 9012","bizum":"612345678","links":[{"label":"Honeymoon Fund","url":"https://example.com"}],"message":"Your presence is our present!"}'
NEXT_PUBLIC_REGISTRY_JSON=""

# Venue map URL — Google Maps / Apple Maps link shown on /info.
# Example: "https://maps.google.com/?q=Villa+del+Sol+Barcelona"
NEXT_PUBLIC_VENUE_MAP_URL=""

# ---------------------------------------------------------------------------
# Server-only — Database
# ---------------------------------------------------------------------------
# Server-only — Database (Postgres, required for Vercel + Docker prod)
# Vercel Postgres / Neon / Supabase, e.g.:
DATABASE_URL="postgresql://myboda:myboda@localhost:5432/myboda"
# Neon example:
# DATABASE_URL="postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/myboda?sslmode=require"
# Local SQLite fallback (dev only, NOT supported on Vercel):
# DATABASE_URL="file:./data/dev.db"

# ---------------------------------------------------------------------------
# Server-only — Admin Dashboard Auth
# ---------------------------------------------------------------------------
# Password for /admin/login — compared via HMAC hash, session cookie httpOnly.
# Bootstrap only — seeds first SYSADMIN via /setup, then unused.
# REQUIRED in production: app fails closed if empty (see src/lib/auth.ts).
# For local dev you may use "admin123"; never commit a real password.
ADMIN_PASSWORD=""
