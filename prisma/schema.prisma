generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Guest {
  id          String       @id @default(cuid())
  name        String
  email       String?
  category    String       @default("family") // family | friends | colleagues | other
  plusOne     Boolean      @default(false)
  plusOneName String?
  householdId    String?
  household      Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  inviteCodeUsed String?
  createdAt   DateTime     @default(now())
  rsvp        RsvpResponse?

  @@unique([email])
}

model RsvpResponse {
  id           String   @id @default(cuid())
  guestId      String   @unique
  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  attending    Boolean
  headcount    Int      @default(1)
  mealChoice   String? // vegetarian | vegan | meat | fish
  dietaryNotes String?
  message      String?
  respondedAt  DateTime @default(now())
}

enum Role {
  COUPLE
  PLANNER
  SYSADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PLANNER)
  createdAt    DateTime @default(now())
}

model Household {
  id         String    @id @default(cuid())
  label      String
  inviteCode String    @unique
  maxGuests  Int       @default(2)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  guests     Guest[]
}

model GalleryPhoto {
  id           String   @id @default(cuid())
  householdId  String
  guestId      String
  uploaderName String
  caption      String?
  fileName     String
  thumbName    String
  mimeType     String
  width        Int
  height       Int
  bytes        Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
