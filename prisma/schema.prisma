generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite (better-sqlite3) is single-writer / file-locked — ideal for single-container
  // deployments with a volume (see docker-compose.yml `sqlite_data`). For multi-instance
  // or high-concurrency production, switch to Postgres:
  //   provider = "postgresql"
  //   url      = env("DATABASE_URL") // e.g. postgresql://user:password@postgres:5432/myboda
  // Then uncomment the `postgres` service in docker-compose.yml and update DATABASE_URL.
  provider = "sqlite"
}

model Guest {
  id          String       @id @default(cuid())
  name        String
  email       String?
  category    String       @default("family") // family | friends | colleagues | other
  plusOne     Boolean      @default(false)
  plusOneName String?
  createdAt   DateTime     @default(now())
  rsvp        RsvpResponse?

  @@unique([email])
}

model RsvpResponse {
  id           String   @id @default(cuid())
  guestId      String   @unique
  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  attending    Boolean
  headcount    Int      @default(1)
  mealChoice   String? // vegetarian | vegan | meat | fish
  dietaryNotes String?
  message      String?
  respondedAt  DateTime @default(now())
}
